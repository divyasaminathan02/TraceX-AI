# TraceX AI - Environment Configuration Template
APP_NAME="TraceX AI Fraud Intelligence Platform"
ENVIRONMENT="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/tracex"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Credentials (used during bootstrap only)
INITIAL_ADMIN_EMAIL="admin@tracex.ai"
INITIAL_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword!"
INITIAL_ADMIN_NAME="System Administrator"

# Risk Thresholds for Fraud Classifications
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_MEDIUM=0.65
RISK_THRESHOLD_HIGH=0.85

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ML Model Paths
ML_MODEL_DIR="ml/models"
